# The API is always reached on the site's own origin. In development the Vite
# dev server forwards /api to the local server (VITE_DEV_API_TARGET); in
# production Netlify forwards it (see netlify.toml).
VITE_API_URL=/api
# Development only: where the local server runs.
VITE_DEV_API_TARGET=http://localhost:5000
